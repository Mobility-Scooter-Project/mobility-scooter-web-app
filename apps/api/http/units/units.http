@baseUrl = {{$dotenv baseUrl}}
@tenantId = {{$dotenv tenantId}}
@unitId = {{$dotenv unitId}}
@userId = {{$dotenv userId}}
@apiKey = {{$dotenv TESTING_API_KEY}}
@token = {{login.response.body.data.token}}

### Validate environment variables
# @name validateEnv
# Ensure required env vars are set
# @test = baseUrl != null && tenantId != null && unitId != null && userId != null && apiKey != null

### Login first to get token
# @name login
POST {{baseUrl}}/api/v1/auth/emailpass
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "testing124"
}

### Create a new unit
# @name createUnit
# Creates a new unit under the specified tenant with an optional admin user
POST {{baseUrl}}/tenant/{{tenantId}}/units
Authorization: Bearer {{apiKey}}
X-User: {{token}}
Content-Type: application/json

{
  "adminUserId": "{{userId}}"
}

### Update a unit
# @name updateUnit
# Updates unit properties like the admin user
PUT {{baseUrl}}/tenant/{{tenantId}}/unit/{{unitId}}
Authorization: Bearer {{apiKey}}
X-User: {{token}}
Content-Type: application/json

{
  "adminUserId": "{{userId}}"
}

### Create an invite token
# @name createInvite
# Creates a JWT token that can be used to invite users to this unit
POST {{baseUrl}}/tenant/{{tenantId}}/unit/{{unitId}}/invite
Authorization: Bearer {{apiKey}}
X-User: {{token}}
Content-Type: application/json

{}

### Accept an invite
# @name acceptInvite
# Uses an invite token to add a user to the unit
POST {{baseUrl}}/unit/invite/accept?token={{createInvite.response.body.token}}
Authorization: Bearer {{apiKey}}
X-User: {{token}}
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### List users in unit
# @name listUsers
# Gets all users in a unit with optional field filtering and pagination
GET {{baseUrl}}/tenant/{{tenantId}}/unit/{{unitId}}/users?fields=id,email,firstName,lastName&limit=50&offset=0
Authorization: Bearer {{apiKey}}
X-User: {{token}}

### Remove user from unit
# @name removeUser
# Removes a user from the unit and moves them to their default unit
DELETE {{baseUrl}}/tenant/{{tenantId}}/unit/{{unitId}}/users/{{userId}}
Authorization: Bearer {{apiKey}}
X-User: {{token}}