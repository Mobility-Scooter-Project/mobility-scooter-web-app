{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "baseUrl": ".",
    "composite": true,
    "paths": {
      "@src/*": [
        "src/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@middleware/*": [
        "src/middleware/*"
      ],
      "@handlers/*": [
        "src/handlers/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@integrations/*": [
        "src/integrations/*"
      ],
      "@repositories/*": [
        "src/repositories/*"
      ],
      "@validators/*": [
        "src/validators/*"
      ],
      "@tests/*": [
        "tests/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}