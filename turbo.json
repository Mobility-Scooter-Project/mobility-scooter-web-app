{
  "$schema": "https://v2-8-2.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "format": {
      "cache": false,
      "persistent": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "cache": false,
      "persistent": false
    },
    "test:e2e": {
      "cache": false,
      "persistent": false
    }
  },
  "ui": "tui"
}